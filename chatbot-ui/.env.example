# Local development: direct to DominicBE
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_TIMEOUT_MS=120000

# Phase 1 auth note:
# the frontend stores the access token in browser localStorage after login/register.
# if backend AUTH_SECRET_KEY changes, users must log in again.

# Production example when frontend is hosted on a different domain than the backend:
# VITE_API_BASE_URL=https://api.dominicapp.dev

# Local Nginx Docker proxy mode:
# VITE_API_BASE_URL=http://127.0.0.1:8080

# Important for Vite deployments:
# VITE_* values are baked into the frontend at build time.
# After changing them, you must rebuild/redeploy the frontend.

# Production example when Nginx serves frontend + backend on the same domain:
# Leave VITE_API_BASE_URL empty so the browser calls the same host via /api/...

